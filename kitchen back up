<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Perry Cafe — Kitchen</title>
<style>
:root { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#17231d; background:#f4f1e8; }
* { box-sizing:border-box; }
body { margin:0; }
header { position:sticky;top:0;z-index:5;background:#163f2b;color:white;padding:16px;box-shadow:0 2px 10px #0002; }
h1 { margin:0;font-size:24px; }
.sub { opacity:.8;font-size:13px;margin-top:4px; }
main { max-width:1000px;margin:auto;padding:16px; }
.tabs { display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px; }
.tab { border:2px solid #163f2b;background:white;color:#163f2b;border-radius:12px;padding:12px;font-weight:800;font-size:15px; }
.tab.active { background:#163f2b;color:white; }
.status { padding:12px 14px;border-radius:12px;background:white;margin-bottom:14px;font-weight:600; }
.grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px; }
.card { background:white;border-radius:16px;padding:16px;box-shadow:0 2px 10px #0001;border-top:6px solid #c7942f; }
.doneCard { border-top-color:#789286; }
.top { display:flex;justify-content:space-between;gap:12px;align-items:flex-start; }
.table { font-size:25px;font-weight:800; }
.ref { font-size:13px;color:#68736d;margin-top:3px; }
.time { font-weight:700;white-space:nowrap; }
.date { font-size:12px;color:#68736d;text-align:right;margin-top:3px; }
.items { margin:16px 0;border-top:1px solid #ddd;border-bottom:1px solid #ddd;padding:8px 0; }
.item { padding:7px 0; }
.item strong { display:block; }
.mods { font-size:13px;color:#5e6863;margin-top:3px;white-space:pre-wrap; }
.total { display:flex;justify-content:space-between;font-size:20px;font-weight:800;margin:12px 0; }
.action { width:100%;border:0;border-radius:12px;padding:13px;font-size:16px;font-weight:800;background:#163f2b;color:white; }
.action:disabled { opacity:.5; }
.empty { text-align:center;background:white;border-radius:16px;padding:42px 20px;color:#64706a;grid-column:1/-1; }
.bad { background:#ffe5e5;color:#8b1f1f; }
.hidden { display:none !important; }
.filters { display:flex;gap:7px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px; }
.filter { flex:0 0 auto;border:1px solid #c8cec9;background:white;color:#33443b;border-radius:999px;padding:9px 12px;font-weight:700; }
.filter.active { background:#163f2b;color:white;border-color:#163f2b; }
.summary { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px; }
.metric { background:white;border-radius:14px;padding:14px;box-shadow:0 2px 8px #0001; }
.metric .label { color:#68736d;font-size:12px;font-weight:700; }
.metric .value { font-size:22px;font-weight:900;margin-top:5px; }
.historyRow { cursor:pointer; }
.historyItems { display:none; }
.historyRow.open .historyItems { display:block; }
.tapHint { text-align:center;color:#68736d;font-size:12px;font-weight:700;margin-top:8px; }
.inventoryGrid { display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px; }
.inventoryCard { background:white;border-radius:14px;padding:16px;box-shadow:0 2px 8px #0001; }
.inventoryName { color:#526159;font-size:14px;font-weight:800; }
.inventoryQty { font-size:28px;font-weight:900;margin-top:5px;color:#163f2b; }
.inventoryNote { font-size:12px;color:#68736d;margin:0 0 14px;line-height:1.4; }
.orderActions { display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px; }
.orderActions .action { margin-top:0; }
.printAction { background:#5b3a29 !important; }
.autoPrintBox { display:flex;justify-content:space-between;align-items:center;gap:12px;background:white;border-radius:14px;padding:12px 14px;margin-bottom:14px;box-shadow:0 2px 8px #0001; }
.autoPrintTitle { font-weight:900; }
.autoPrintHint { color:#68736d;font-size:12px;margin-top:3px;line-height:1.35; }
.autoPrintControls { display:flex;gap:8px;flex:0 0 auto; }
.autoPrintBtn { flex:0 0 auto;border:0;border-radius:999px;padding:11px 16px;font-size:14px;font-weight:900;background:#6f7773;color:white; }
.testPrintBtn { background:#5b3a29;color:white;border:0;border-radius:999px;padding:11px 16px;font-size:14px;font-weight:900; }
.autoPrintBtn.on { background:#168447; }
@media(max-width:560px){
  .tabs { grid-template-columns:1fr; }
  .summary { grid-template-columns:1fr; }
  .metric { display:flex;justify-content:space-between;align-items:center; }
  .metric .value { margin:0;font-size:20px; }
  .autoPrintBox { flex-wrap:wrap; }
  .autoPrintControls { width:100%; }
  .autoPrintControls button { flex:1; }
}
</style>
</head>
<body>
<header>
  <h1>Perry Cafe — Kitchen</h1>
  <div class="sub">Live orders, order history &amp; inventory</div>
</header>
<main>
  <div class="tabs">
    <button id="liveTab" class="tab active" onclick="showView('live')">LIVE ORDERS</button>
    <button id="historyTab" class="tab" onclick="showView('history')">ORDER HISTORY</button>
    <button id="inventoryTab" class="tab" onclick="showView('inventory')">INVENTORY</button>
  </div>
  <section id="liveView">
    <div class="autoPrintBox">
      <div>
        <div id="autoPrintTitle" class="autoPrintTitle">AUTO PRINT: ON (WINDOWS)</div>
        <div id="autoPrintHint" class="autoPrintHint">Uses Microsoft Edge and your Windows default receipt printer.</div>
      </div>
      <div class="autoPrintControls"><button class="testPrintBtn" onclick="testPrinter()">TEST PRINTER</button><button id="autoPrintBtn" class="autoPrintBtn" onclick="toggleAutoPrint()">TURN OFF</button></div>
    </div>
    <div id="status" class="status">Connecting to Perry Cafe…</div>
    <div id="orders" class="grid"></div>
  </section>
  <section id="historyView" class="hidden">
    <div class="filters historyFilters">
      <button class="filter active" data-range="today" onclick="setRange('today',this)">Today</button>
      <button class="filter" data-range="yesterday" onclick="setRange('yesterday',this)">Yesterday</button>
      <button class="filter" data-range="7days" onclick="setRange('7days',this)">Last 7 Days</button>
      <button class="filter" data-range="month" onclick="setRange('month',this)">This Month</button>
    </div>
    <div class="summary">
      <div class="metric"><div class="label">COMPLETED ORDERS</div><div id="completedCount" class="value">0</div></div>
      <div class="metric"><div class="label">ORDER VALUE</div><div id="orderValue" class="value">£0.00</div></div>
      <div class="metric"><div class="label">AVERAGE ORDER</div><div id="averageOrder" class="value">£0.00</div></div>
    </div>
    <div id="historyStatus" class="status">Loading order history…</div>
    <div id="historyOrders" class="grid"></div>
  </section>
  <section id="inventoryView" class="hidden">
    <div class="filters inventoryFilters">
      <button class="filter active" data-range="today" onclick="setInventoryRange('today',this)">Today</button>
      <button class="filter" data-range="yesterday" onclick="setInventoryRange('yesterday',this)">Yesterday</button>
      <button class="filter" data-range="7days" onclick="setInventoryRange('7days',this)">Last 7 Days</button>
      <button class="filter" data-range="month" onclick="setInventoryRange('month',this)">This Month</button>
    </div>
    <p class="inventoryNote">Counts ingredients from completed breakfast orders, subtracting removed items and adding selected extras.</p>
    <div id="inventoryStatus" class="status">Loading inventory usage…</div>
    <div id="inventoryGrid" class="inventoryGrid"></div>
  </section>
</main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://plwtpcqwjfqzpkrnlzfq.supabase.co';
const SUPABASE_KEY='sb_publishable_gxMkbIdN_JF3A7PSv3OXVQ_RL_LTmKi';
const db=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const statusEl=document.getElementById('status'),ordersEl=document.getElementById('orders'),historyStatusEl=document.getElementById('historyStatus'),historyOrdersEl=document.getElementById('historyOrders'),inventoryStatusEl=document.getElementById('inventoryStatus'),inventoryGridEl=document.getElementById('inventoryGrid');
let currentView='live',currentRange='today',inventoryRange='today';
function money(v){return '£'+Number(v||0).toFixed(2)}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function timeOf(v){return new Date(v).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}
function dateOf(v){return new Date(v).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}
function describeItem(x){
 if(x?.type==='order_note')return `<div class="item"><strong>Order note</strong><div class="mods">${esc(x.note)}</div></div>`;
 const qty=x?.qty??x?.quantity??1,name=x?.name??x?.title??x?.item??'Item';let details=[];
 const removed=Array.isArray(x?.removed)?x.removed:(Array.isArray(x?.remove)?x.remove:[]);
 if(x?.choice)details.push('CHOICE: '+x.choice);
 if(removed.length)details.push('NO: '+removed.join(', '));
 if(Array.isArray(x?.extras)&&x.extras.length)details.push('EXTRA: '+x.extras.map(e=>typeof e==='string'?e:(e.name||e.label||'')).filter(Boolean).join(', '));
 if(x?.customText)details.push(x.customText);
 if(x?.notes||x?.note)details.push('NOTE: '+(x.notes||x.note));
 return `<div class="item"><strong>${esc(qty)} × ${esc(name)}</strong>${details.length?`<div class="mods">${esc(details.join('\n'))}</div>`:''}</div>`;
}
let liveOrdersById=new Map();
function renderLive(rows){
 liveOrdersById=new Map(rows.map(o=>[Number(o.id),o]));
 if(!rows.length){ordersEl.innerHTML=`<div class="empty">No new orders right now.</div>`;return}
 ordersEl.innerHTML=rows.map(o=>`<article class="card"><div class="top"><div><div class="table">TABLE ${esc(o.table_number)}</div><div class="ref">${esc(o.order_ref||('Order #'+o.id))}</div></div><div class="time">${timeOf(o.created_at)}</div></div><div class="items">${(Array.isArray(o.items)?o.items:[]).map(describeItem).join('')}</div><div class="total"><span>Total</span><span>${money(o.total)}</span></div><div class="orderActions"><button class="action printAction" onclick="printReceiptById(${Number(o.id)})">PRINT RECEIPT</button><button class="action" onclick="markDone(${Number(o.id)})">MARK DONE</button></div></article>`).join('');
}
function renderHistory(rows){
 const total=rows.reduce((sum,o)=>sum+Number(o.total||0),0);
 document.getElementById('completedCount').textContent=rows.length;document.getElementById('orderValue').textContent=money(total);document.getElementById('averageOrder').textContent=money(rows.length?total/rows.length:0);
 historyStatusEl.textContent=`${rows.length} completed order${rows.length===1?'':'s'} • newest first`;
 if(!rows.length){historyOrdersEl.innerHTML=`<div class="empty">No completed orders in this period.</div>`;return}
 historyOrdersEl.innerHTML=rows.map(o=>`<article class="card doneCard historyRow" onclick="this.classList.toggle('open')"><div class="top"><div><div class="table">TABLE ${esc(o.table_number)}</div><div class="ref">${esc(o.order_ref||('Order #'+o.id))}</div></div><div><div class="time">${timeOf(o.created_at)}</div><div class="date">${dateOf(o.created_at)}</div></div></div><div class="total"><span>Total</span><span>${money(o.total)}</span></div><div class="historyItems items">${(Array.isArray(o.items)?o.items:[]).map(describeItem).join('')}</div><div class="tapHint">Tap to view/hide order details</div></article>`).join('');
}
/* Orders + history + inventory: unchanged business rules. */
let firstOrderLoad=true;
let latestOrdersRequest=0;
async function loadOrders(){
 const request=++latestOrdersRequest;
 const {data,error}=await db.from('orders').select('*').eq('status','new').order('created_at',{ascending:false});
 if(request!==latestOrdersRequest)return;
 if(error){console.error(error);statusEl.textContent='Could not load orders — check Supabase permissions.';statusEl.classList.add('bad');return}
 statusEl.classList.remove('bad');statusEl.textContent=`Live • ${data.length} new order${data.length===1?'':'s'}`;renderLive(data);
 // Do not automatically reprint existing tickets on the initial page load.
 // Later polling can recover a new ticket if Supabase Realtime briefly disconnects.
 if(firstOrderLoad){firstOrderLoad=false;data.forEach(o=>knownOrderIds.add(String(o.id)));}
 else for(const order of data){if(!knownOrderIds.has(String(order.id))){knownOrderIds.add(String(order.id));tryAutoPrint(order)}}
}
function rangeBounds(range){
 const now=new Date();let start,end;
 if(range==='today'){start=new Date(now.getFullYear(),now.getMonth(),now.getDate());end=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1)}
 else if(range==='yesterday'){start=new Date(now.getFullYear(),now.getMonth(),now.getDate()-1);end=new Date(now.getFullYear(),now.getMonth(),now.getDate())}
 else if(range==='7days'){start=new Date(now.getFullYear(),now.getMonth(),now.getDate()-6);end=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1)}
 else{start=new Date(now.getFullYear(),now.getMonth(),1);end=new Date(now.getFullYear(),now.getMonth()+1,1)}
 return{start:start.toISOString(),end:end.toISOString()};
}
async function loadHistory(){
 const {start,end}=rangeBounds(currentRange);historyStatusEl.textContent='Loading order history…';historyStatusEl.classList.remove('bad');
 const {data,error}=await db.from('orders').select('*').eq('status','done').gte('created_at',start).lt('created_at',end).order('created_at',{ascending:false});
 if(error){console.error(error);historyStatusEl.textContent='Could not load order history — check Supabase permissions.';historyStatusEl.classList.add('bad');renderHistory([]);return}
 renderHistory(data||[]);
}
const RECIPES={
 'Small Breakfast':{'Eggs':1,'Bacon rashers':2,'Sausages':1,'Beans portions':1},
 'Traditional Breakfast':{'Eggs':1,'Bacon rashers':2,'Sausages':1,'Chips portions':1,'Beans portions':1},
 'Early Starter':{'Eggs':2,'Bacon rashers':2,'Hash browns':2,'Tomatoes portions':1,'Beans portions':1},
 'The Brunch Breakfast':{'Eggs':2,'Bacon rashers':2,'Sausages':2,'Tomatoes portions':1,'Mushrooms portions':1},
 'Perry Special':{'Eggs':1,'Bacon rashers':2,'Sausages':1,'Black pudding pieces':3,'Bubble portions':1,'Beans portions':1},
 'Classic Breakfast':{'Eggs':2,'Bacon rashers':2,'Sausages':2,'Beans portions':1,'Mushrooms portions':1,'Tomatoes portions':1},
 'Sunrise Breakfast':{'Eggs':2,'Bacon rashers':2,'Sausages':2,'Chips portions':1,'Hash browns':2,'Mushrooms portions':1,'Tomatoes portions':1,'Beans portions':1}
};
const REMOVE_KEYS={
 'egg':['Eggs'],'eggs':['Eggs'],'scrambled egg':['Eggs'],
 'bacon':['Bacon rashers'],'sausage':['Sausages'],'sausages':['Sausages'],
 'beans':['Beans portions'],'chips':['Chips portions'],'hash browns':['Hash browns'],
 'hash brown':['Hash browns'],'tomato':['Tomatoes portions'],'tomatoes':['Tomatoes portions'],
 'mushrooms':['Mushrooms portions'],'mushroom':['Mushrooms portions'],
 'black pudding':['Black pudding pieces'],'bubble':['Bubble portions']
};
const EXTRA_MAP=[
 [/fried slice/i,'Fried slice pieces'],[/toast/i,'Toast slices'],[/scrambled egg/i,'Eggs'],[/\begg\b/i,'Eggs'],
 [/beans/i,'Beans portions'],[/coleslaw/i,'Coleslaw portions'],[/tomato/i,'Tomatoes portions'],[/mushroom/i,'Mushrooms portions'],
 [/fried onions/i,'Fried onions portions'],[/onion rings/i,'Onion rings'],[/beef burger/i,'Beef burgers'],[/\bham\b/i,'Ham portions'],
 [/bacon/i,'Bacon rashers'],[/frankfurter/i,'Frankfurters'],[/\bliver\b/i,'Liver portions'],[/black pudding/i,'Black pudding pieces'],
 [/sausage/i,'Sausages'],[/bubble/i,'Bubble portions'],[/chips/i,'Chips portions'],[/mash potato/i,'Mash potato portions'],[/hash brown/i,'Hash browns']
];
function addCount(out,key,n){out[key]=(out[key]||0)+Number(n||0);if(out[key]<0)out[key]=0}
function inventoryFrom(rows){
 const out={};
 rows.forEach(o=>(Array.isArray(o.items)?o.items:[]).forEach(x=>{
   if(x?.type==='order_note')return;
   const qty=Number(x?.qty??x?.quantity??1)||1, recipe=RECIPES[x?.name];
   if(recipe){
     Object.entries(recipe).forEach(([k,n])=>addCount(out,k,n*qty));
     const removed=Array.isArray(x?.removed)?x.removed:(Array.isArray(x?.remove)?x.remove:[]);
     removed.forEach(r=>{
       const keys=REMOVE_KEYS[String(r).trim().toLowerCase()]||[];
       keys.forEach(k=>{ const recipeQty=recipe[k]||0; if(recipeQty)addCount(out,k,-recipeQty*qty); });
     });
   }
   (Array.isArray(x?.extras)?x.extras:[]).forEach(e=>{
     const s=typeof e==='string'?e:(e?.name||e?.label||'');
     const m=String(s).match(/^\s*(\d+)\s*[×x]\s*(.+?)(?:\s*\(\+£.*)?$/i);
     const count=m?Number(m[1]):1, label=m?m[2]:String(s);
     for(const [re,key] of EXTRA_MAP){if(re.test(label)){addCount(out,key,count*qty);break}}
   });
 }));
 return out;
}
function renderInventory(rows){
 const counts=inventoryFrom(rows);
 const entries=Object.entries(counts).filter(([,v])=>v>0).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0]));
 inventoryStatusEl.textContent=`${rows.length} completed order${rows.length===1?'':'s'} analysed`;
 if(!entries.length){inventoryGridEl.innerHTML=`<div class="empty">No tracked ingredients used in this period.</div>`;return}
 inventoryGridEl.innerHTML=entries.map(([name,qty])=>`<div class="inventoryCard"><div class="inventoryName">${esc(name)}</div><div class="inventoryQty">${esc(qty)}</div></div>`).join('');
}
async function loadInventory(){
 const {start,end}=rangeBounds(inventoryRange);inventoryStatusEl.textContent='Loading inventory usage…';inventoryStatusEl.classList.remove('bad');
 const {data,error}=await db.from('orders').select('items,created_at,status').eq('status','done').gte('created_at',start).lt('created_at',end).order('created_at',{ascending:false});
 if(error){console.error(error);inventoryStatusEl.textContent='Could not load inventory — check Supabase permissions.';inventoryStatusEl.classList.add('bad');inventoryGridEl.innerHTML='';return}
 renderInventory(data||[]);
}
function showView(view){
 currentView=view;
 document.getElementById('liveView').classList.toggle('hidden',view!=='live');
 document.getElementById('historyView').classList.toggle('hidden',view!=='history');
 document.getElementById('inventoryView').classList.toggle('hidden',view!=='inventory');
 document.getElementById('liveTab').classList.toggle('active',view==='live');
 document.getElementById('historyTab').classList.toggle('active',view==='history');
 document.getElementById('inventoryTab').classList.toggle('active',view==='inventory');
 if(view==='history')loadHistory();
 if(view==='inventory')loadInventory();
}
function setRange(range,el){currentRange=range;document.querySelectorAll('.historyFilters .filter').forEach(x=>x.classList.remove('active'));el.classList.add('active');loadHistory()}
function setInventoryRange(range,el){inventoryRange=range;document.querySelectorAll('.inventoryFilters .filter').forEach(x=>x.classList.remove('active'));el.classList.add('active');loadInventory()}

/* WINDOWS / EDGE RECEIPT PRINTING.
   Edge's SilentPrintingEnabled policy must be enabled, and 80Printer must be the
   Windows default printer. Browser printing uses the Windows printer driver,
   not an Android app, a WebSocket, or raw ESC/POS. */
function receiptHtml(order){
 const items=Array.isArray(order?.items)?order.items:[];
 const itemHtml=items.map(x=>{
   if(x?.type==='order_note')return `<div class="orderNote"><b>ORDER NOTE:</b> ${esc(x.note||'')}</div>`;
   const qty=x?.qty??x?.quantity??1,name=x?.name??x?.title??x?.item??'Item';
   const removed=Array.isArray(x?.removed)?x.removed:(Array.isArray(x?.remove)?x.remove:[]);
   let mods=[];
   if(x?.choice)mods.push(`<div><b>CHOICE:</b> ${esc(x.choice)}</div>`);
   if(removed.length)mods.push(`<div><b>NO:</b> ${esc(removed.join(', '))}</div>`);
   if(Array.isArray(x?.extras)&&x.extras.length){
     const extras=x.extras.map(e=>typeof e==='string'?e:(e?.name||e?.label||'')).filter(Boolean);
     if(extras.length)mods.push(`<div><b>EXTRA:</b> ${esc(extras.join(', '))}</div>`);
   }
   if(x?.customText)mods.push(`<div>${esc(x.customText)}</div>`);
   if(x?.notes||x?.note)mods.push(`<div><b>NOTE:</b> ${esc(x.notes||x.note)}</div>`);
   return `<div class="line"><div class="itemName"><b>${esc(qty)} × ${esc(name)}</b></div>${mods.join('')}</div>`;
 }).join('');
 const ref=esc(order?.order_ref||('Order #'+(order?.id??'')));
 const table=esc(order?.table_number??'');
 const when=order?.created_at?`${dateOf(order.created_at)} ${timeOf(order.created_at)}`:'';
 return `<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Perry Cafe Kitchen Ticket</title><style>
 @page{margin:2mm}
 *{box-sizing:border-box}
 html,body{margin:0;padding:0;background:#fff;color:#000}
 body{width:72mm;max-width:72mm;font-family:Arial,sans-serif;font-size:12px;line-height:1.3}
 .c{text-align:center}.cafe{font-size:20px;font-weight:900}.table{font-size:25px;font-weight:900;margin:3px 0}
 .meta{font-size:10px}.rule{border-top:1px dashed #000;margin:7px 0}
 .line{padding:5px 0;border-bottom:1px dotted #777;break-inside:avoid}
 .itemName{font-size:13px;margin-bottom:2px}
 .orderNote{border:2px solid #000;padding:5px;margin:6px 0;font-size:12px;break-inside:avoid}
 .total{display:flex;justify-content:space-between;font-size:17px;font-weight:900;margin-top:8px}
 .footer{font-size:10px;margin-top:10px}
 </style></head><body><div class="c"><div class="cafe">PERRY CAFE</div><div class="table">TABLE ${table}</div><div class="meta">${ref}<br>${esc(when)}</div></div><div class="rule"></div>${itemHtml}<div class="rule"></div><div class="total"><span>TOTAL</span><span>${money(order?.total)}</span></div><div class="rule"></div><div class="c footer">Kitchen Order</div></body></html>`;
}

// A print iframe avoids window.open() popup blockers. It is off-screen, not display:none.
// Print jobs are serialized so simultaneous orders cannot overwrite each other.
const printQueue=[];
let printingNow=false;
let autoPrintEnabled=true;
const knownOrderIds=new Set();
const queuedOrPrinted=new Set();
const PRINTED_STORAGE_KEY='perry_cafe_windows_printed_ids_v1';
try{
 const saved=JSON.parse(localStorage.getItem(PRINTED_STORAGE_KEY)||'[]');
 if(Array.isArray(saved))saved.forEach(id=>queuedOrPrinted.add(String(id)));
}catch(e){console.warn('Could not read printed ticket history',e)}
function rememberPrintedId(id){
 queuedOrPrinted.add(String(id));
 try{
  const recent=Array.from(queuedOrPrinted).slice(-300);
  localStorage.setItem(PRINTED_STORAGE_KEY,JSON.stringify(recent));
  if(queuedOrPrinted.size>400){queuedOrPrinted.clear();recent.forEach(x=>queuedOrPrinted.add(x))}
 }catch(e){console.warn('Could not save printed ticket history',e)}
}
function updateAutoPrintUI(message){
 const title=document.getElementById('autoPrintTitle');
 const button=document.getElementById('autoPrintBtn');
 const hint=document.getElementById('autoPrintHint');
 title.textContent=autoPrintEnabled?'AUTO PRINT: ON (WINDOWS)':'AUTO PRINT: OFF';
 button.textContent=autoPrintEnabled?'TURN OFF':'TURN ON';
 button.classList.toggle('on',autoPrintEnabled);
 if(message)hint.textContent=message;
 else if(autoPrintEnabled)hint.textContent='Uses Edge silent printing and the Windows default 80Printer. Keep this page open.';
 else hint.textContent='Automatic printing paused. PRINT RECEIPT still works.';
}
function toggleAutoPrint(){
 autoPrintEnabled=!autoPrintEnabled;
 updateAutoPrintUI();
}
function enqueueReceipt(order,{automatic=false}={}){
 if(!order)return false;
 const id=String(order.id??'');
 if(automatic){
  if(!autoPrintEnabled||!id||queuedOrPrinted.has(id))return false;
  // Record before attempting to print: avoids duplicates on rapid realtime/poll events.
  // Note: browser print() cannot confirm physical printer success; use manual reprint if necessary.
  rememberPrintedId(id);
 }
 printQueue.push({order,automatic});
 processPrintQueue();
 return true;
}
async function processPrintQueue(){
 if(printingNow)return;
 printingNow=true;
 while(printQueue.length){
  const {order,automatic}=printQueue.shift();
  const label=order.order_ref||('Order #'+(order.id??'TEST'));
  try{
   await printWithIframe(receiptHtml(order));
   updateAutoPrintUI(`${automatic?'Sent automatically':'Sent to Windows printer'}: ${label}. Check that a paper receipt printed.`);
  }catch(e){
   console.error('Printing failed',e);
   updateAutoPrintUI(`Could not send ${label} to Edge. Tap PRINT RECEIPT to retry.`);
  }
 }
 printingNow=false;
}
function printWithIframe(html){
 return new Promise((resolve,reject)=>{
  const frame=document.createElement('iframe');
  frame.setAttribute('title','Kitchen receipt printing');
  frame.setAttribute('aria-hidden','true');
  frame.style.cssText='position:fixed;left:-10000px;top:0;width:80mm;height:600px;border:0;opacity:0;pointer-events:none';
  document.body.appendChild(frame);
  let finished=false;
  let timeoutId;
  const cleanup=()=>{
   if(finished)return;
   finished=true;
   clearTimeout(timeoutId);
   setTimeout(()=>frame.remove(),1200);
   // Give the Windows print spooler time before sending another job.
   setTimeout(resolve,1800);
  };
  try{
   const doc=frame.contentDocument;
   doc.open();doc.write(html);doc.close();
   frame.contentWindow.addEventListener('afterprint',cleanup,{once:true});
   // afterprint is not guaranteed on all Edge versions; don't deadlock the queue.
   timeoutId=setTimeout(cleanup,4500);
   setTimeout(()=>{
    try{frame.contentWindow.focus();frame.contentWindow.print()}
    catch(e){if(!finished){finished=true;clearTimeout(timeoutId);frame.remove();reject(e)}}
   },300);
  }catch(e){finished=true;clearTimeout(timeoutId);frame.remove();reject(e)}
 });
}
function printReceiptById(id){
 const order=liveOrdersById.get(Number(id));
 if(!order){alert('This order is no longer in the live order list. Refresh and try again.');return}
 enqueueReceipt(order); // Manual reprints are always allowed.
}
function testPrinter(){
 const testOrder={id:'TEST',order_ref:'WINDOWS PRINT TEST',table_number:'TEST',created_at:new Date().toISOString(),total:0,items:[{qty:1,name:'Perry Cafe printer test — no order has been placed.'}]};
 enqueueReceipt(testOrder);
}
function tryAutoPrint(order){
 if(!autoPrintEnabled||!order||order.status!=='new')return;
 const id=String(order.id??'');
 if(!id||queuedOrPrinted.has(id))return;
 // Only auto-print orders that arrived since this kitchen page was opened.
 // Older live orders can still be printed manually using PRINT RECEIPT.
 const createdAt=new Date(order.created_at).getTime();
 if(!Number.isFinite(createdAt)||createdAt<pageOpenedAt-5000)return;
 enqueueReceipt(order,{automatic:true});
}
const pageOpenedAt=Date.now();
async function markDone(id){
 const {error}=await db.from('orders').update({status:'done'}).eq('id',id);
 if(error){alert('Could not mark this order as done.');console.error(error);return}
 await loadOrders();if(currentView==='history')await loadHistory();if(currentView==='inventory')await loadInventory();
}
db.channel('perry-kitchen')
.on('postgres_changes',{event:'*',schema:'public',table:'orders'},payload=>{
 if(payload.eventType==='INSERT'){
  knownOrderIds.add(String(payload.new?.id));
  // Fetch the full row from the database to ensure receipt items are present.
  if(payload.new?.id!=null)db.from('orders').select('*').eq('id',payload.new.id).single().then(({data,error})=>{
   if(!error&&data)tryAutoPrint(data);
   else console.error('Could not fetch new order for printing',error);
  });
 }
 loadOrders();
 if(currentView==='history')loadHistory();
 if(currentView==='inventory')loadInventory();
})
.subscribe(state=>{if(state==='SUBSCRIBED')loadOrders()});
updateAutoPrintUI();
loadOrders();
// Backup polling for when realtime messages are missed. Keeps working while on History/Inventory.
setInterval(loadOrders,12000);
</script>
